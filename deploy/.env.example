# ============================================
# AI Aggregator Platform - Environment Configuration (SINGLE SOURCE)
# ============================================
# 复制为 .env 并填入真实值：`cp .env.example .env`
# 这是整个平台唯一的环境模板。docker-compose 以此做变量替换，backend / harness-worker
# 通过 env_file 读取本文件。backend/frontend 目录下不再单独维护 .env / .env.example。
# 真实密钥只写入 .env（已被 .gitignore 忽略），仓库仅提交本模板（占位符）。
# ============================================

# ============================================
# Database Configuration
# ============================================
# NOTE: DB_PASSWORD 使用原始密码（供 MySQL 初始化）；
#       DB_PASSWORD_URLENCODED 使用 URL 编码密码（供 DATABASE_URL）。
DB_ROOT_PASSWORD=your_db_root_password
DB_NAME=ai_aggregator
DB_USER=ai_user
DB_PASSWORD=your_db_password
DB_PASSWORD_URLENCODED=your_db_password_urlencoded
DB_PORT=3306

# ============================================
# Security Configuration
# ============================================
# IMPORTANT: 生产环境务必替换为随机 32+ 位字符串
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# AI Aggregation Gateway (New API, OpenAI-compatible)
# ============================================
# Single gateway + single token for ALL AI model calls
# (text -> deepseek-v4-flash, image -> wan, video -> happyhorse/hailuo/seedance)
#
# 注意：这两个值仅在「首次启动」时被播种为 DB 里的默认网关组
# (gateway_configs 表, is_default=True)。此后网关凭证改由 DB 统一管理——
# 管理员可在前端「网关管理」页面配置多组凭证并映射给不同用户；
# 已存在默认组后，修改这里的值不会再回写数据库。
AI_GATEWAY_BASE_URL=https://neolink.com/api/v1
AI_GATEWAY_API_KEY=your-ai-gateway-api-key

# ============================================
# Application Configuration
# ============================================
# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend API URL (used during build; empty = same-origin via nginx proxy)
VITE_API_URL=

# CORS Origins (JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# Default credits for new users
DEFAULT_CREDITS=200
CREDIT_RECHARGE_ENABLED=true

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging level
LOG_LEVEL=INFO
# Echo every SQL statement to stdout (very noisy; dev-only). Default false.
SQL_ECHO=false
# Log the outbound request body/form of each AI-gateway model call (prompt, model,
# ratio/duration, reference-frame kinds) for diagnosing upstream rejections. Default true.
LOG_MODEL_REQUESTS=true

# Container user/group id (match host user to avoid volume permission issues)
UID=1000
GID=1000

# ============================================
# MinIO Object Storage
# ============================================
# MinIO admin credentials (change in production!)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Bucket name
MINIO_BUCKET=ai-aggregator
# Ports exposed on host
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Set to false to disable MinIO and keep local-only storage
MINIO_ENABLED=true
# Public URL MinIO uses in presigned URLs (must be browser-accessible).
# For local dev: http://localhost:9000  |  For production: https://minio.yourdomain.com
MINIO_PUBLIC_URL=http://localhost:9000
# Public endpoint for presigned URL generation (host:port, no scheme).
# For local dev: localhost:9000  |  For production: minio.yourdomain.com
MINIO_PUBLIC_ENDPOINT=localhost:9000

# Public origin of this backend (reachable by external services like Seedance).
# Used to build token-signed streaming URLs for Seedance reference video/audio.
PUBLIC_BASE_URL=https://your-domain.com

# ============================================
# Alipay (支付宝)
# ============================================
# 从支付宝开放平台获取。私钥/公钥需去除 -----BEGIN/END----- 头尾标记与换行，仅留纯 Base64。
# 沙箱申请：https://openhome.alipay.com/develop/sandbox/app
ALIPAY_APPID=your_alipay_appid
ALIPAY_APP_PRIVATE_KEY=your_app_private_key_here
ALIPAY_PUBLIC_KEY=your_alipay_public_key_here
# 沙箱：https://openapi-sandbox.dl.alipaydev.com/gateway.do | 生产：https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SIGN_TYPE=RSA2
# 前端支付完成后跳转页
ALIPAY_RETURN_URL=http://localhost:3000/recharge
# 后端异步通知地址（必须公网可访问；本地可用 ngrok http 8000 暴露）
ALIPAY_NOTIFY_URL=https://your-domain.com/api/v1/payment/alipay/notify
# 订单超时（分钟）
ALIPAY_ORDER_TIMEOUT=30

# ============================================
# Douyin Open Platform (抖音开放平台)
# ============================================
# 注册：https://developer.open-douyin.com/ （创建应用 → 申请"视频管理"能力 → 获取 Key/Secret）
# 回调地址必须与抖音开放平台注册的一致
DOUYIN_CLIENT_KEY=your-douyin-client-key
DOUYIN_CLIENT_SECRET=your-douyin-client-secret
DOUYIN_REDIRECT_URI=https://your-domain.com/douyin/callback
